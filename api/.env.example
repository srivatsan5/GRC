# ---------------------------------------------------------------------------
# Pericope API configuration. Copy to api/.env (never commit the real file).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Browser origins allowed to call the API (comma separated). Required.
CORS_ORIGINS=http://localhost:3000

# Session signing secret: at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session lifetime in minutes
SESSION_TTL_MINUTES=480
# Set true when the API is served over HTTPS (production)
COOKIE_SECURE=false
# Optional cookie domain, e.g. .datapulsefusion.com when the app and API are on sibling subdomains
COOKIE_DOMAIN=

# Where users.json and the audit chain are stored
DATA_DIR=./data

# First administrator, created on startup only when no users exist yet
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=

# Oracle ORDS (Autonomous DB) — OAuth2 client credentials
ORDS_BASE_URL=https://<your-adb-host>/ords/<schema>
ORDS_TOKEN_URL=https://<your-adb-host>/ords/<schema>/oauth/token
ORDS_CLIENT_ID=
ORDS_CLIENT_SECRET=
# Only for local experiments against an ORDS schema with no auth. Never in production.
ORDS_ALLOW_ANONYMOUS=false
ORDS_TIMEOUT_MS=8000

# Requests per minute per IP (general / login)
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_15_MIN=10

# Express trust-proxy: number of reverse proxies in front of the API, or 'loopback'
TRUST_PROXY=loopback
