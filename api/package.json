{
  "name": "pericope-api",
  "version": "4.0.0",
  "private": true,
  "description": "Pericope ERM API — authenticated backend-for-frontend over Oracle ORDS",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx scripts/write-openapi.ts",
    "user:create": "tsx scripts/create-user.ts",
    "check:ords-anon": "node scripts/check-ords-anonymous.mjs",
    "dev:fake-db": "tsx scripts/fake-ords.ts"
  },
  "dependencies": {
    "@sentry/node": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7",
    "vitest": "^5.0.5"
  }
}
